# chezmoi:template:left-delimiter="% [[" right-delimiter="]]"
% [[ template "managed_by_chezmoi.tmpl" ]]
% [[- $pythonConfig := dig "python" "global_venv" dict . ]]

[tools]
python = % [[ get $pythonConfig "python_version" | default "latest" | quote ]]

[env]
% [[- $vendDir := get $pythonConfig "path" | default (env "XDG_DATA_HOME" | default "~/.local/share") ]]
% [[- $venvName := get $pythonConfig "name" | default "global-venv" ]]
_.python.venv = { path = "% [[ joinPath $vendDir $venvName ]]", create = true }
UV_PYTHON = { value = "{{ tools.python.path }}", tools = true }

[settings]
python.uv_venv_auto = "source"
idiomatic_version_file_enable_tools = ["python"]