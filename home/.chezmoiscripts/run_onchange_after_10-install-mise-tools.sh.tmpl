{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash

if ! command -v mise >/dev/null 2>&1; then
  echo "mise is not installed, skipping tool installation" >&2
  exit 0
fi

# mise.tools: {{ output "mise" "ls" "--cd" .chezmoi.destDir "--current" "--json" | trim | sha256sum }}
# Run from $HOME so project-local mise configs are not picked up
cd "$HOME" && mise install
{{- end }}
